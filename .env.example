# Copy this file to `.env` and paste in your real token.
#   cp .env.example .env
#
# The bearer token comes from https://developer.x.com
#   -> your Project -> your App -> "Keys and tokens" -> Bearer Token -> Generate
#
# It is one long string starting with "AAAAAAAA". No quotes, no spaces around
# the `=`, all on one line. `.env` is gitignored — never commit the real token,
# and never paste it into a chat or an issue. Anyone holding it can spend your
# API credits.

X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAPASTE_YOUR_REAL_TOKEN_HERE
