# Copy this file to `.env` and fill in ONE of the two options below.
#   cp .env.example .env
#
# Both come from https://developer.x.com
#   -> your Project -> your App -> "Keys and tokens"
#
# `.env` is gitignored. Never commit these, never paste them into a chat or an
# issue. Anyone holding them can spend your API credits. If one does leak,
# regenerate it on that same console page — that invalidates the old one.

# --- Option A: the bearer token -------------------------------------------
# One long string starting with "AAAA". Shown only once when generated.
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAPASTE_YOUR_REAL_TOKEN_HERE

# --- Option B: the API Key / Secret pair -----------------------------------
# Listed higher up the same page, and regenerable any time. If you use these,
# delete or comment out Option A above; xhire exchanges the pair for a bearer
# token automatically at startup (a free call, not billed as a read).
# X_API_KEY=                 # 25 characters
# X_API_SECRET=              # 50 characters
